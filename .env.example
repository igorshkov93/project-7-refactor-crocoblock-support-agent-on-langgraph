# Active provider: anthropic | gemini
LLM_PROVIDER=anthropic

# Provider credentials. Only the key for the active provider is required;
# startup fails fast if it is missing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GOOGLE_API_KEY=xxxxxxxx

# Model behaviour
MAX_OUTPUT_TOKENS=4000
DEFAULT_TEMPERATURE=0.0

# Retrieval
PINECONE_API_KEY=
COHERE_API_KEY=
PINECONE_INDEX=jetformbuilder-docs
PINECONE_NAMESPACE=jfb

# Changing EMBED_MODEL means rebuilding the index: the dimension must match.
EMBED_MODEL=embed-v4.0
RERANK_MODEL=rerank-v3.5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_N=5

# WordPress sandbox. WP_APP_PASSWORD is an application password,
# not the account password.
WP_BASE_URL=
WP_USER=
WP_APP_PASSWORD=

# Routing. Requests scoring below the threshold go to a human.
CONFIDENCE_THRESHOLD=0.6
MAX_CLARIFYING_ROUNDS=2

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=60
PINECONE_TIMEOUT_SECONDS=10
COHERE_TIMEOUT_SECONDS=15
WP_TIMEOUT_SECONDS=20

# Retry policy
RETRY_ATTEMPTS=3
RETRY_INITIAL_WAIT=1.0
RETRY_MAX_WAIT=10.0

# Observability. Enabling tracing without a key fails at startup by design:
# silent tracing that loses every run is worse than a clear error.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project-7-crocoblock-support