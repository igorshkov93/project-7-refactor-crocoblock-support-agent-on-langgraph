
# Active provider: anthropic | gemini
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
GOOGLE_API_KEY=xxxxxxxx

# Needed in later steps
PINECONE_API_KEY=
COHERE_API_KEY=
WP_BASE_URL=
WP_USER=
WP_APP_PASSWORD=

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=60
PINECONE_TIMEOUT_SECONDS=10
COHERE_TIMEOUT_SECONDS=15
WP_TIMEOUT_SECONDS=20

# Retry policy
RETRY_ATTEMPTS=3
RETRY_INITIAL_WAIT=1.0
RETRY_MAX_WAIT=10.0

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=project-7-crocoblock-support